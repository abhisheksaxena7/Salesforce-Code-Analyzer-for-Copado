# NOTE: docker --env-file does not support multi-line values https://docs.docker.com/engine/reference/commandline/run/#env

# predefined parameters to contact the Copado organization, to send events, notify finish, errors, results, file upload and download, etc
CF_SF_ENDPOINT=https://copado.com
CF_SF_SESSIONID=dummy
CF_RESULTID=dummy

# special variable that will avoid the "copado" command contacting the Copado Org.
# no events will be sent, files downloaded, or uploaded
CF_COPADO_TESTING_MODE=1

# example of git json with https authentication
git_json={"type": "https", "url": "https://domain:copado-labs/repository.git", "username": "", "password": ""}

# any custom parameter you wish to send
parameter1=value1

# optional ApexGuru analysis org. Use a single eligible Production or Full Copy
# environment where ApexGuru is activated. Never commit a real session ID.
apexGuruEndpoint=https://example.my.salesforce.com
apexGuruSessionId=dummy
